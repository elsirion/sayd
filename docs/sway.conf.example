# sayd -- add to ~/.config/sway/config
#
# Note there is no $(...) anywhere: the daemon reads the selection itself
# through wlr-data-control, so no selected text ever passes through a shell
# and nothing can mangle the quoting.

exec sayd

bindsym $mod+Shift+s exec say selection
bindsym $mod+Shift+v exec say clipboard
bindsym $mod+Shift+m exec say stop

# Media keys, via the MPRIS2 interface sayd registers as
# org.mpris.MediaPlayer2.sayd -- `playerctl -p sayd` addresses it by that
# name's suffix. Previous is deliberately not bound: sayd advertises
# CanGoPrevious: false (an utterance is synthesised chunk by chunk with no
# addressable buffer to seek back into), and playerctl already refuses a
# Previous call against a player that reports it, so binding it would just
# be dead.
bindsym XF86AudioPlay exec playerctl -p sayd play-pause
bindsym XF86AudioPause exec playerctl -p sayd pause
bindsym XF86AudioStop exec playerctl -p sayd stop
bindsym XF86AudioNext exec playerctl -p sayd next
