# Optional. sayd is normally started from the sway config with `exec sayd`,
# which ties its lifetime to the session that it needs anyway. This unit is
# for people who prefer systemd to manage it.
#
# Install to ~/.config/systemd/user/sayd.service, then:
#   systemctl --user enable --now sayd.service
#
# A systemd user unit does NOT inherit the compositor's environment. Without
# WAYLAND_DISPLAY, sayd starts and serves D-Bus and the tray perfectly well but
# every selection read fails with "could not read the primary selection". Give
# sway the matching line so the session hands its environment to systemd
# *before* this unit starts:
#
#   exec systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR \
#     SWAYSOCK XDG_CURRENT_DESKTOP
#
# (sway's own `exec sayd` needs none of this -- it inherits the environment
# directly, which is why it is the default the README recommends.)

[Unit]
Description=sayd text-to-speech daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/sayd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
